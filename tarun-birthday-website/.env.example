# The Tarun Times — Environment Configuration Template
# Copy this file to .env and fill in your values.

# Google Apps Script Web App URL (from Apps Script Deploy -> Web app)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Shared secret passphrase matching SHARED_SECRET in google-apps-script.gs
SHARED_SECRET=your_secret_passphrase_here
